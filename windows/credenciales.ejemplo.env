# Credenciales del Vigía. Este fichero solo vive en el ordenador donde corre: nunca en git.
# Escribe cada valor después del =, sin espacios ni comillas. Guarda y cierra.

# --- WordPress: usuario «vigia» (rol Suscriptor): leer los logs y bloquear IPs ---
# Solo sirve para eso: no puede publicar, borrar ni ver nada más. Ver README.md.
VIGIA_WP_USER=vigia
VIGIA_WP_APP_PASSWORD=

# --- WhatsApp (CallMeBot) ---
# Teléfono con prefijo, sin espacios: +34600111222
# La clave te la da CallMeBot por WhatsApp (ver README.md).
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

# --- Telegram (avisos con botones y órdenes: /bloquear, /estado, /silenciar…) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- FTPS: SOLO en el centro de operaciones (logs completos de Apache y ficheros) ---
# En el ordenador de la radio déjalo vacío: allí los logs llegan por la web.
# FTP_TLS_NOMBRE: el nombre para el que está emitido el certificado del FTP, si no es FTP_HOST.
FTP_HOST=
FTP_TLS_NOMBRE=
FTP_USER=
FTP_PASS=
